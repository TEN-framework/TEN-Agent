{
  "type": "extension",
  "name": "websocket_server",
  "version": "0.0.2",
  "display_name": {
    "locales": {
      "en-US": {
        "content": "WebSocket Server"
      },
      "zh-CN": {
        "content": "WebSocket \u670d\u52a1\u5668"
      },
      "zh-TW": {
        "content": "WebSocket \u4f3a\u670d\u5668"
      },
      "ja-JP": {
        "content": "WebSocket\u30b5\u30fc\u30d0\u30fc"
      },
      "ko-KR": {
        "content": "WebSocket \uc11c\ubc84"
      }
    }
  },
  "description": {
    "locales": {
      "en-US": {
        "content": "WebSocket server extension that receives base64-encoded PCM audio and forwards it as TEN AudioFrames"
      },
      "zh-CN": {
        "content": "WebSocket \u670d\u52a1\u5668\u6269\u5c55\uff0c\u63a5\u6536 base64 \u7f16\u7801\u7684 PCM \u97f3\u9891\u5e76\u5c06\u5176\u4f5c\u4e3a TEN AudioFrames \u8f6c\u53d1"
      },
      "zh-TW": {
        "content": "WebSocket \u4f3a\u670d\u5668\u64f4\u5145\uff0c\u63a5\u6536 base64 \u7de8\u78bc\u7684 PCM \u97f3\u8a0a\u4e26\u5c07\u5176\u4f5c\u70ba TEN AudioFrames \u8f49\u767c"
      },
      "ja-JP": {
        "content": "base64\u30a8\u30f3\u30b3\u30fc\u30c9\u3055\u308c\u305fPCM\u30aa\u30fc\u30c7\u30a3\u30aa\u3092\u53d7\u4fe1\u3057\u3001TEN AudioFrames\u3068\u3057\u3066\u8ee2\u9001\u3059\u308bWebSocket\u30b5\u30fc\u30d0\u30fc\u62e1\u5f35"
      },
      "ko-KR": {
        "content": "base64\ub85c \uc778\ucf54\ub529\ub41c PCM \uc624\ub514\uc624\ub97c \uc218\uc2e0\ud558\uace0 TEN AudioFrames\ub85c \uc804\ub2ec\ud558\ub294 WebSocket \uc11c\ubc84 \ud655\uc7a5"
      }
    }
  },
  "readme": {
    "locales": {
      "en-US": {
        "import_uri": "docs/README.en-US.md"
      },
      "zh-CN": {
        "import_uri": "docs/README.zh-CN.md"
      },
      "zh-TW": {
        "import_uri": "docs/README.zh-TW.md"
      },
      "ja-JP": {
        "import_uri": "docs/README.ja-JP.md"
      },
      "ko-KR": {
        "import_uri": "docs/README.ko-KR.md"
      }
    }
  },
  "tags": [
    "python",
    "websocket",
    "audio",
    "server",
    "input"
  ],
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    }
  ],
  "package": {
    "include": [
      "manifest.json",
      "property.json",
      "tests/**.py",
      "tests/bin/*",
      "pyproject.toml",
      "requirements.txt",
      "docs/**",
      ".vscode/**"
    ]
  },
  "api": {
    "property": {
      "properties": {
        "port": {
          "type": "int32"
        },
        "host": {
          "type": "string"
        },
        "sample_rate": {
          "type": "int32"
        },
        "channels": {
          "type": "int32"
        },
        "bytes_per_sample": {
          "type": "int32"
        },
        "dump": {
          "type": "bool"
        },
        "dump_path": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "properties": {}
        },
        "command_timeout_ms": {
          "type": "int32"
        }
      }
    },
    "data_in": [
      {
        "name": "text_data"
      },
      {
        "name": "asr_result"
      },
      {
        "name": "agora_mind_event"
      },
      {
        "name": "tts_audio_start"
      },
      {
        "name": "tts_audio_end"
      },
      {
        "name": "tts_text_result"
      },
      {
        "name": "tts_flush_end"
      },
      {
        "name": "error"
      },
      {
        "name": "metrics"
      }
    ],
    "data_out": [
      {
        "name": "pcm_frame",
        "property": {
          "properties": {
            "metadata": {
              "type": "object",
              "properties": {}
            }
          }
        }
      }
    ],
    "cmd_in": [],
    "cmd_out": [
      {
        "name": "create_workspace"
      },
      {
        "name": "create_session"
      },
      {
        "name": "flush_session"
      },
      {
        "name": "set_session_debug"
      },
      {
        "name": "delete_session"
      }
    ],
    "audio_frame_in": [
      {
        "name": "pcm_frame"
      }
    ],
    "audio_frame_out": [
      {
        "name": "pcm_frame"
      }
    ],
    "video_frame_in": [],
    "video_frame_out": []
  },
  "scripts": {
    "test": "tests/bin/start"
  }
}
