{
  "type": "extension",
  "name": "iflytek_asr_python",
  "version": "0.2.0",
  "display_name": {
    "locales": {
      "en-US": {
        "content": "iFLYTEK ASR Python Extension"
      },
      "zh-CN": {
        "content": "讯飞 ASR Python 扩展"
      },
      "zh-TW": {
        "content": "訊飛 ASR Python 擴充"
      },
      "ja-JP": {
        "content": "iFLYTEK ASR Python 拡張"
      },
      "ko-KR": {
        "content": "iFLYTEK ASR Python 확장"
      }
    }
  },
  "description": {
    "locales": {
      "en-US": {
        "content": "TEN Framework ASR extension for the iFLYTEK realtime transcription service"
      },
      "zh-CN": {
        "content": "接入讯飞实时转写服务的 TEN Framework Python ASR 扩展"
      },
      "zh-TW": {
        "content": "接入訊飛即時轉寫服務的 TEN Framework Python ASR 擴充"
      },
      "ja-JP": {
        "content": "iFLYTEK リアルタイム文字起こし用 TEN Framework ASR 拡張"
      },
      "ko-KR": {
        "content": "iFLYTEK 실시간 전사 서비스용 TEN Framework ASR 확장"
      }
    }
  },
  "readme": {
    "locales": {
      "en-US": {
        "import_uri": "docs/README.en-US.md"
      },
      "zh-CN": {
        "import_uri": "docs/README.zh-CN.md"
      },
      "zh-TW": {
        "import_uri": "docs/README.zh-TW.md"
      },
      "ja-JP": {
        "import_uri": "docs/README.ja-JP.md"
      },
      "ko-KR": {
        "import_uri": "docs/README.ko-KR.md"
      }
    }
  },
  "tags": [
    "python",
    "iflytek",
    "websocket",
    "asr"
  ],
  "dependencies": [
    {
      "type": "system",
      "name": "ten_runtime_python",
      "version": "0.11"
    },
    {
      "type": "system",
      "name": "ten_ai_base",
      "version": "0.7"
    }
  ],
  "api": {
    "interface": [
      {
        "import_uri": "../../system/ten_ai_base/api/asr-interface.json"
      }
    ],
    "property": {
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "app_id": {
              "type": "string"
            },
            "biz_id": {
              "type": "string"
            },
            "trace_id_prefix": {
              "type": "string"
            },
            "sample_rate": {
              "type": "int64"
            },
            "language": {
              "type": "string"
            },
            "engine": {
              "type": "object",
              "properties": {}
            },
            "res_id_list": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hotwords": {
              "type": "string"
            },
            "hotword_weight": {
              "type": "float64"
            },
            "voiceprints": {
              "type": "object",
              "properties": {}
            },
            "connect_timeout": {
              "type": "float64"
            },
            "finalize_timeout": {
              "type": "float64"
            },
            "reconnect_delay": {
              "type": "float64"
            },
            "reconnect_max_delay": {
              "type": "float64"
            },
            "reconnect_max_attempts": {
              "type": "int64"
            },
            "buffer_max_bytes": {
              "type": "int64"
            }
          }
        },
        "dump": {
          "type": "bool"
        },
        "dump_path": {
          "type": "string"
        }
      }
    }
  },
  "package": {
    "include": [
      "README.md",
      "CHANGELOG.md",
      "manifest.json",
      "property.json",
      "**.tent",
      "**.py",
      "pyproject.toml",
      "requirements.txt",
      "docs/**",
      "tests/bin/bootstrap",
      "tests/bin/bootstrap_and_start",
      "tests/bin/start",
      "tests/pyproject.toml"
    ]
  },
  "scripts": {
    "test": "tests/bin/start"
  }
}
